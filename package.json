{
  "name": "projekt-aegis",
  "version": "0.1.0",
  "private": true,
  "description": "Projekt Aegis - Secure OpenClaw sidecar sandbox",
  "workspaces": [
    "apps/*",
    "packages/*",
    "extensions/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/aegis-desktop",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
